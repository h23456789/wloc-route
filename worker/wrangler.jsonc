{
  "name": "wloc-spoofer",
  "main": "src/index.js",
  // 執行時語義快照。這個 Worker 只用 fetch/URL/TextDecoder 等標準 Web API,
  // 不需要 nodejs_compat —— 實測去掉後產物位元組數完全一致, 且省掉一份啟動開銷。
  "compatibility_date": "2026-08-05",
  // 關閉持久化日誌採集, 與 README 中「/api/parse 不記日誌」的說法對齊。
  // 除錯仍可用 `wrangler tail`, 那是實時流, 不落盤。
  "observability": { "enabled": false }
}
